      "description": "Campo e select della regia su fondo notte.",
      "html": "<textarea class=\"ds-campo\" rows=\"3\" placeholder=\"Tra dieci minuti si spengono le luci.\"></textarea>",
      "css": ":host{--notte:#0e0b14;--notte-2:#17121f;--notte-3:#231b2e;--filetto:#3a2f48;--osso:#eee6d6;--osso-2:#b8aec4;--zucca:#ff7a1a;--zucca-chiara:#ff9a4d;--cera:#8e1b24;--cera-luce:#b8323c;--sangue:#ff5a5f;--gotico:'Grenze Gotisch',serif;--testo:'Barlow',system-ui,sans-serif;--curva-uscita:cubic-bezier(0.23,1,0.32,1);--curva-cassetto:cubic-bezier(0.32,0.72,0,1);}.ds-campo{width:100%;min-height:48px;border-radius:10px;border:1px solid var(--filetto,#3a2f48);background:var(--notte,#0e0b14);color:var(--osso,#eee6d6);padding:10px 14px;font:400 17px/1.5 var(--testo,'Barlow',system-ui,sans-serif);caret-color:var(--zucca,#ff7a1a);}.ds-campo::placeholder{color:var(--osso-2,#b8aec4);}.ds-campo:focus-visible{outline:2px solid var(--zucca,#ff7a1a);outline-offset:3px;}"
    },
    {
      "name": "Barra a schede",
      "kind": "nav",
      "refersTo": "schede",
      "description": "Navigazione del telefono: quattro voci con icona a tratto, corrente in zucca.",
      "html": "<nav class=\"ds-schede\"><a href=\"#\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\"><rect x=\"3\" y=\"6\" width=\"18\" height=\"13\" rx=\"1.5\"/><path d=\"M3 7l9 6 9-6\"/><circle cx=\"12\" cy=\"15.5\" r=\"2.2\"/></svg>Prove</a><a href=\"#\"><svg viewBox=\"0 0 24 24\"><circle cx=\"9\" cy=\"8\" r=\"3.2\"/><path d=\"M3 20c.8-3.4 3.2-5.4 6-5.4s5.2 2 6 5.4\"/><circle cx=\"17\" cy=\"9\" r=\"2.4\"/><path d=\"M16 14.6c2.4.2 4.2 2 5 5\"/></svg>Personaggi</a><a href=\"#\"><svg viewBox=\"0 0 24 24\"><path d=\"M6 3h12v18H6z\"/><path d=\"M9 8h6M9 12h6M9 16h3\"/></svg>Taccuino</a><a href=\"#\"><svg viewBox=\"0 0 24 24\"><path d=\"M5 20 15 10\"/><path d=\"M13 4l7 7-3 3-7-7z\"/><path d=\"M3 21h8\"/></svg>Accusa</a></nav>",
      "css": ":host{--notte:#0e0b14;--notte-2:#17121f;--notte-3:#231b2e;--filetto:#3a2f48;--osso:#eee6d6;--osso-2:#b8aec4;--zucca:#ff7a1a;--zucca-chiara:#ff9a4d;--cera:#8e1b24;--cera-luce:#b8323c;--sangue:#ff5a5f;--gotico:'Grenze Gotisch',serif;--testo:'Barlow',system-ui,sans-serif;--curva-uscita:cubic-bezier(0.23,1,0.32,1);--curva-cassetto:cubic-bezier(0.32,0.72,0,1);}.ds-schede{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));padding:6px 8px;background:var(--notte,#0e0b14);border-top:1px solid var(--notte-3,#231b2e);}.ds-schede a{min-height:60px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;font:500 13px var(--testo,'Barlow',system-ui,sans-serif);color:var(--osso-2,#b8aec4);text-decoration:none;border-radius:12px;}.ds-schede a:hover{color:var(--osso,#eee6d6);}.ds-schede a[aria-current=page]{color:var(--zucca,#ff7a1a);font-weight:700;}.ds-schede a:focus-visible{outline:2px solid var(--zucca,#ff7a1a);outline-offset:3px;}.ds-schede svg{width:22px;height:22px;stroke:currentColor;stroke-width:1.75;fill:none;stroke-linecap:round;stroke-linejoin:round;}"
    },
    {
      "name": "Prova d'inventario",
      "kind": "card",
      "refersTo": "reperto-aperto",
      "description": "Scheda del fascicolo, aperta e sigillata: angoli netti, filetto, numero di catalogo.",
      "html": "<div class=\"ds-griglia\"><a class=\"ds-reperto ds-reperto--aperto\" href=\"#\"><div class=\"ds-reperto-testa\"><svg class=\"ds-icona\" viewBox=\"0 0 24 24\"><path d=\"M6 3h8l4 4v14H6z\"/><path d=\"M14 3v4h4\"/><path d=\"M9 12h6M9 16h6\"/></svg><span class=\"ds-numero\">N. 1</span></div><div class=\"ds-reperto-corpo\"><div class=\"ds-reperto-titolo\">Lettera bruciacchiata</div><div class=\"ds-reperto-nota\">Documento, trovata alle 20:58</div></div></a><button class=\"ds-reperto ds-reperto--sigillato\" type=\"button\"><div class=\"ds-reperto-testa\"><svg width=\"40\" height=\"40\" viewBox=\"0 0 100 100\"><path fill=\"#8e1b24\" d=\"M50 4c6 0 9 5 14 6s11-2 15 2 2 10 5 14 9 6 9 12-5 9-5 14 4 10 1 15-10 4-13 8-3 10-8 12-11-1-16 0-9 6-15 3-6-9-11-12-12-2-14-7 3-10 1-15-8-8-6-13 8-7 9-12-2-12 3-15 11 0 15-3 6-9 11-10Z\"/><circle cx=\"50\" cy=\"50\" r=\"29\" fill=\"none\" stroke=\"#b8323c\" stroke-width=\"2.5\"/></svg><span class=\"ds-numero\">N. 3</span></div><div class=\"ds-reperto-corpo\"><div class=\"ds-reperto-titolo\">Sigillata</div><div class=\"ds-reperto-nota\">Serve un codice trovato in sala</div></div></button></div>",
      "css": ":host{--notte:#0e0b14;--notte-2:#17121f;--notte-3:#231b2e;--filetto:#3a2f48;--osso:#eee6d6;--osso-2:#b8aec4;--zucca:#ff7a1a;--zucca-chiara:#ff9a4d;--cera:#8e1b24;--cera-luce:#b8323c;--sangue:#ff5a5f;--gotico:'Grenze Gotisch',serif;--testo:'Barlow',system-ui,sans-serif;--curva-uscita:cubic-bezier(0.23,1,0.32,1);--curva-cassetto:cubic-bezier(0.32,0.72,0,1);}.ds-griglia{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;max-width:420px;}.ds-reperto{min-height:164px;padding:0 0 14px;border-radius:2px;display:flex;flex-direction:column;gap:12px;text-align:left;text-decoration:none;color:var(--osso,#eee6d6);border:1px solid var(--filetto,#3a2f48);background:var(--notte-2,#17121f);font-family:var(--testo,'Barlow',system-ui,sans-serif);cursor:pointer;}.ds-reperto:hover{background:var(--notte-3,#231b2e);}.ds-reperto:focus-visible{outline:2px solid var(--zucca,#ff7a1a);outline-offset:3px;}.ds-reperto--aperto{border-color:var(--osso-2,#b8aec4);}.ds-reperto--aperto .ds-reperto-testa{border-bottom-color:var(--osso-2,#b8aec4);}.ds-reperto--sigillato{background:var(--notte,#0e0b14);border-color:var(--zucca,#ff7a1a);}.ds-reperto-testa{display:flex;justify-content:space-between;align-items:center;gap:8px;padding:8px 14px;min-height:52px;border-bottom:1px solid var(--filetto,#3a2f48);}.ds-reperto-corpo{padding:0 14px;margin-top:auto;}.ds-reperto-titolo{font-weight:600;font-size:16px;line-height:1.25;}.ds-reperto-nota{font-size:14px;line-height:1.35;color:var(--osso-2,#b8aec4);}.ds-reperto--sigillato .ds-reperto-nota{color:var(--osso,#eee6d6);}.ds-numero{font-size:13px;font-weight:600;letter-spacing:0.04em;color:var(--osso-2,#b8aec4);}.ds-icona{width:26px;height:26px;stroke:var(--zucca,#ff7a1a);stroke-width:1.75;fill:none;stroke-linecap:round;stroke-linejoin:round;}"
    },
    {
      "name": "Tastierino del sigillo",
      "kind": "custom",
      "refersTo": "tasto",
      "description": "Caselle del PIN e tastierino 3 per 4; Apri in zucca resta spento finché le cifre non sono quattro.",
      "html": "<div class=\"ds-pin\"><div class=\"ds-caselle\"><div class=\"ds-casella ds-piena\">&bull;</div><div class=\"ds-casella ds-piena\">&bull;</div><div class=\"ds-casella\"></div><div class=\"ds-casella\"></div></div><div class=\"ds-tastiera\"><button class=\"ds-tasto\">1</button><button class=\"ds-tasto\">2</button><button class=\"ds-tasto\">3</button><button class=\"ds-tasto ds-tasto--leggero\">Cancella</button><button class=\"ds-tasto\">0</button><button class=\"ds-tasto ds-tasto--apri\">Apri</button></div></div>",
      "css": ":host{--notte:#0e0b14;--notte-2:#17121f;--notte-3:#231b2e;--filetto:#3a2f48;--osso:#eee6d6;--osso-2:#b8aec4;--zucca:#ff7a1a;--zucca-chiara:#ff9a4d;--cera:#8e1b24;--cera-luce:#b8323c;--sangue:#ff5a5f;--gotico:'Grenze Gotisch',serif;--testo:'Barlow',system-ui,sans-serif;--curva-uscita:cubic-bezier(0.23,1,0.32,1);--curva-cassetto:cubic-bezier(0.32,0.72,0,1);}.ds-pin{display:grid;gap:22px;max-width:360px;font-family:var(--testo,'Barlow',system-ui,sans-serif);}.ds-caselle{display:flex;justify-content:center;gap:12px;}.ds-casella{width:58px;height:68px;border-radius:12px;border:1.5px solid var(--filetto,#3a2f48);display:grid;place-items:center;font-size:30px;font-weight:600;color:var(--osso,#eee6d6);}.ds-piena{border-color:var(--zucca,#ff7a1a);}.ds-tastiera{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;}.ds-tasto{min-height:64px;border-radius:16px;border:0;background:var(--notte-3,#231b2e);font:600 28px var(--testo,'Barlow',system-ui,sans-serif);color:var(--osso,#eee6d6);cursor:pointer;transition:transform 120ms cubic-bezier(0.23,1,0.32,1),background-color 160ms ease;}.ds-tasto:hover{background:var(--filetto,#3a2f48);}.ds-tasto:active{transform:scale(0.97);}.ds-tasto:focus-visible{outline:2px solid var(--zucca,#ff7a1a);outline-offset:3px;}.ds-tasto--leggero{background:transparent;font-size:16px;color:var(--osso-2,#b8aec4);}.ds-tasto--apri{background:var(--zucca,#ff7a1a);color:var(--notte,#0e0b14);font-size:17px;font-weight:700;}.ds-tasto--apri:hover{background:var(--zucca-chiara,#ff9a4d);}"
    },
    {
      "name": "Documento rivelato",
      "kind": "card",
      "refersTo": "documento",
      "description": "Il foglio di carta della prova aperta, con intestazione stampata e timbro di ceralacca.",
      "html": "<div class=\"ds-documento\"><div class=\"ds-intestazione\"><span>FASCICOLO N. 3</span><span>VILLA CORVINA</span></div><strong>Oggetto</strong><p>Una chiave di ferro, ancora calda. Sul cartellino di cuoio qualcuno ha inciso un numero:</p><p class=\"ds-codice\">6613</p><span class=\"ds-timbro\">AGLI ATTI</span></div>",
      "css": ":host{--notte:#0e0b14;--notte-2:#17121f;--notte-3:#231b2e;--filetto:#3a2f48;--osso:#eee6d6;--osso-2:#b8aec4;--zucca:#ff7a1a;--zucca-chiara:#ff9a4d;--cera:#8e1b24;--cera-luce:#b8323c;--sangue:#ff5a5f;--gotico:'Grenze Gotisch',serif;--testo:'Barlow',system-ui,sans-serif;--curva-uscita:cubic-bezier(0.23,1,0.32,1);--curva-cassetto:cubic-bezier(0.32,0.72,0,1);}.ds-documento{position:relative;max-width:380px;background:var(--osso,#eee6d6);color:var(--notte,#0e0b14);border-radius:2px;padding:0 18px 22px;display:grid;gap:10px;font-family:var(--testo,'Barlow',system-ui,sans-serif);}.ds-intestazione{display:flex;justify-content:space-between;gap:10px;padding:12px 0 10px;border-bottom:1.5px solid var(--notte,#0e0b14);font-size:13px;font-weight:700;letter-spacing:0.04em;}.ds-documento strong{font-family:var(--gotico,'Grenze Gotisch',serif);font-size:28px;line-height:1.05;font-weight:700;margin-top:6px;}.ds-documento p{margin:0;font-size:16px;line-height:1.5;padding-bottom:6px;border-bottom:1px solid #c9bfae;}.ds-codice{font-weight:700;font-size:18px !important;letter-spacing:0.08em;}.ds-timbro{position:absolute;right:14px;bottom:16px;transform:rotate(-9deg);border:2px solid var(--cera,#8e1b24);color:var(--cera,#8e1b24);font-weight:700;font-size:14px;letter-spacing:0.08em;padding:2px 8px;border-radius:2px;}"
    },
    {
      "name": "Scheda squadra della regia",
      "kind": "card",
      "refersTo": "scheda-regia",
      "description": "Stato di una squadra: tacche delle prove, ultima attività, allarme in sangue se ferma.",
      "html": "<div class=\"ds-squadra ds-ferma\"><div class=\"ds-squadra-testa\"><b>Pipistrelli</b><span>2 prove su 6</span></div><div class=\"ds-tacche\"><i class=\"ds-si\"></i><i class=\"ds-si\"></i><i></i><i></i><i></i><i></i></div><small>Ferma da 14 minuti</small><button class=\"ds-aiutino\" type=\"button\">Manda un aiutino</button></div>",
      "css": ":host{--notte:#0e0b14;--notte-2:#17121f;--notte-3:#231b2e;--filetto:#3a2f48;--osso:#eee6d6;--osso-2:#b8aec4;--zucca:#ff7a1a;--zucca-chiara:#ff9a4d;--cera:#8e1b24;--cera-luce:#b8323c;--sangue:#ff5a5f;--gotico:'Grenze Gotisch',serif;--testo:'Barlow',system-ui,sans-serif;--curva-uscita:cubic-bezier(0.23,1,0.32,1);--curva-cassetto:cubic-bezier(0.32,0.72,0,1);}.ds-squadra{max-width:420px;background:var(--notte-2,#17121f);border-radius:14px;padding:14px 16px;display:grid;gap:10px;color:var(--osso,#eee6d6);font-family:var(--testo,'Barlow',system-ui,sans-serif);}.ds-squadra-testa{display:flex;justify-content:space-between;align-items:baseline;gap:12px;}.ds-squadra-testa b{font-size:17px;}.ds-squadra-testa span{color:var(--osso-2,#b8aec4);font-size:15px;}.ds-tacche{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:4px;}.ds-tacche i{height:8px;border-radius:4px;background:var(--notte-3,#231b2e);}.ds-tacche i.ds-si{background:var(--zucca,#ff7a1a);}.ds-squadra small{font-size:14px;color:var(--osso-2,#b8aec4);}.ds-ferma small{color:var(--sangue,#ff5a5f);font-weight:600;}.ds-aiutino{justify-self:start;min-height:40px;padding:0 16px;border-radius:999px;border:1px solid var(--filetto,#3a2f48);background:transparent;color:var(--osso,#eee6d6);font:600 15px var(--testo,'Barlow',system-ui,sans-serif);cursor:pointer;}.ds-aiutino:hover{border-color:var(--osso-2,#b8aec4);}.ds-aiutino:focus-visible{outline:2px solid var(--zucca,#ff7a1a);outline-offset:3px;}"
    }

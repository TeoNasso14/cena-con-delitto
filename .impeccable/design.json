      "html": "<button class=\"ds-bottone\" type=\"button\">Schermo nero</button>",
      "css": ":host{--notte:#0e0b14;--notte-2:#17121f;--notte-3:#231b2e;--filetto:#3a2f48;--osso:#eee6d6;--osso-2:#b8aec4;--zucca:#ff7a1a;--zucca-chiara:#ff9a4d;--cera:#8e1b24;--cera-luce:#b8323c;--sangue:#ff5a5f;--gotico:'Grenze Gotisch',serif;--testo:'Barlow',system-ui,sans-serif;--curva-uscita:cubic-bezier(0.23,1,0.32,1);--curva-cassetto:cubic-bezier(0.32,0.72,0,1);}.ds-bottone{min-height:48px;padding:0 22px;border-radius:999px;border:1px solid var(--filetto,#3a2f48);background:transparent;color:var(--osso,#eee6d6);font-family:var(--testo,'Barlow',system-ui,sans-serif);font-weight:600;font-size:16px;display:inline-flex;align-items:center;justify-content:center;gap:10px;cursor:pointer;transition:transform 120ms cubic-bezier(0.23,1,0.32,1),background-color 160ms ease,border-color 160ms ease;}.ds-bottone:hover{border-color:var(--osso-2,#b8aec4);}.ds-bottone:active{transform:scale(0.97);}.ds-bottone:focus-visible{outline:2px solid var(--zucca,#ff7a1a);outline-offset:3px;}"
    },
    {
      "name": "Campo",
      "kind": "input",
